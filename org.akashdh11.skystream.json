{
    "app-id": "org.akashdh11.skystream",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "skystream",
    "modules": [
        {
            "name": "skystream",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/bin /app/share/applications",
                "cp -r * /app/bin/",
                "chmod +x /app/bin/skystream",
                "install -Dm644 org.akashdh11.skystream.desktop /app/share/applications/org.akashdh11.skystream.desktop"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/akashdh11/skystream/releases/download/v2.8.1/skystream-linux-x64-v2.8.1.tar.gz",
                    "sha256": "7931e3a13c7770a92ad70ef519dcff4a31b5e6966350398a6829aae2c031a363"
                },
                {
                    "type": "file",
                    "path": "org.akashdh11.skystream.desktop",
                    "dest-filename": "org.akashdh11.skystream.desktop"
                }
            ]
        }
    ],
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=wayland",
        "--socket=x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=xdg-download"
    ]
}
